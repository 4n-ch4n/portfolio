---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Home from "../components/home.astro";
import Experience from "../components/experience.astro";
import Projects from "../components/projects.astro";
import Skills from "../components/skills.astro";
import Education from "../components/education.astro";
import Contact from "../components/contact.astro";
import Footer from "../components/footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
---

<Layout
  title="Anthony Londoño Calle | Full Stack Developer"
  description="Full stack developer specializing in Node.js and clean architecture. Building distributed backends in production — five microservices at Iglua, hands-on Kubernetes, and a self-directed track into Go."
>
  <Nav />
  <main id="main">
    <Home />
    <Experience />
    <Projects />
    <Skills />
    <Education />
    <Contact />
  </main>
  <Footer />
  <ScrollReveal />
</Layout>
