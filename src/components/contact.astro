        href="mailto:an7honycl06@gmail.com"
        class="text-body underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
      >
        an7honycl06@gmail.com
      </a>
      <a
        href="https://www.linkedin.com/in/anthony-londono-97996b357"
        target="_blank"
        rel="noopener noreferrer"
        class="text-body underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
      >
        LinkedIn ↗
      </a>
      <a
        href="https://github.com/4n-ch4n"
