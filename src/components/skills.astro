---
import { skillLayers, learning, languages } from "../data/skills";
import SectionHeading from "./SectionHeading.astro";
import TechIcon from "./TechIcon.astro";
---

<section class="border-b border-rule py-16 md:py-20" id="skills">
  <div class="mx-auto max-w-5xl space-y-10 px-6 md:px-8">
    <SectionHeading label="Stack" title="The stack, by where it sits" />

    <div class="border border-rule bg-raised" data-reveal>
      {
        skillLayers.map((layer, i) => (
          <div
            class:list={[
              "grid gap-3 px-5 py-4 md:grid-cols-[168px_minmax(0,1fr)] md:items-center md:gap-6",
              i > 0 && "border-t border-rule",
            ]}
          >
            <div class="flex items-baseline gap-2.5">
              <span class="font-mono text-[11px] text-accent">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-heading text-[15px] font-semibold text-ink">
                {layer.label}
              </h3>
            </div>
            <ul class="flex flex-wrap gap-2">
              {layer.skills.map((skill) => (
                <li class="inline-flex items-center gap-1.5 rounded border border-rule bg-surface px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-body">
                  <TechIcon icon={skill.icon} />
                  {skill.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p
      class="flex items-center gap-2 font-mono text-xs text-muted"
      data-reveal
      style="--reveal-delay:60ms"
    >
      <TechIcon icon={learning.icon} />
      {learning.name} — learning now, not production-ready yet
    </p>

    <div
      class="flex flex-wrap gap-x-6 gap-y-1 border-t border-rule pt-6 font-mono text-sm text-muted"
    >
      {
        languages.map((lang) => (
          <span>
            {lang.language} <span class="text-body">({lang.level})</span>
          </span>
        ))
      }
    </div>
  </div>
</section>
