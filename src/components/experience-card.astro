---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"experience">["data"];

const {
  company,
  role,
  startDate,
  endDate,
  location,
  highlights,
  skillsUsed,
  url,
} = Astro.props;
---

<article
  class="space-y-7 rounded-lg border border-rule bg-raised p-6 transition-colors duration-150 hover:border-accent md:p-8"
>
  <div class="space-y-2">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="font-heading text-2xl font-semibold text-ink md:text-3xl">
        {role}
      </h3>
      <span class="font-mono text-sm text-muted">{startDate} – {endDate}</span>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-sm md:text-base">
      <span class="font-semibold text-accent">{company}</span>
      <span class="text-muted">·</span>
      <span class="text-muted">{location}</span>
    </div>
  </div>

  <dl class="space-y-5 border-l border-rule pl-6">
    {
      highlights.map((highlight) => (
        <div class="relative">
          <span
            class="absolute top-2 -left-6.25 size-2 rounded-full border border-accent bg-raised"
            aria-hidden="true"
          />
          <dt class="font-heading font-semibold text-ink">{highlight.title}</dt>
          <dd class="mt-1 max-w-[62ch] text-sm leading-relaxed text-body md:text-base">
            {highlight.body}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="flex flex-wrap gap-2 border-t border-rule pt-5">
    {
      skillsUsed.map((skill) => (
        <span class="rounded-md border border-rule px-2.5 py-1 font-mono text-xs text-body">
          {skill}
        </span>
      ))
    }
  </div>

  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-block font-mono text-sm text-body underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
  >
    {company} ↗
  </a>
</article>
