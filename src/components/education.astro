---
import { education } from "../data/education";
import SectionHeading from "./SectionHeading.astro";
---

<section class="border-b border-rule py-14 md:py-16" id="education">
  <div class="mx-auto max-w-5xl space-y-8 px-6 md:px-8">
    <SectionHeading label="Education" title="Studying alongside the work" />

    <ul class="space-y-4">
      {
        education.map((entry, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
            class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-rule pb-4 last:border-b-0 last:pb-0"
          >
            <div>
              <p class="font-heading font-semibold text-ink">
                {entry.institution}
              </p>
              <p class="text-sm text-body">{entry.program}</p>
            </div>
            <div class="text-right font-mono text-xs text-muted">
              <p>
                {entry.startDate} – {entry.endDate}
              </p>
              <p>{entry.location}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
