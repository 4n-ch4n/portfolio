---
interface Props {
  label: string;
  title: string;
  lede?: string;
}

const { label, title, lede } = Astro.props;
---

<div class="space-y-4" data-reveal>
  <div class="flex items-center gap-3">
    <span
      class="size-2 shrink-0 rounded-full border border-accent bg-accent-soft"
      aria-hidden="true"></span>
    <span class="font-mono text-xs tracking-widest text-accent uppercase">
      {label}
    </span>
    <span class="h-px min-w-8 flex-1 bg-rule" aria-hidden="true"></span>
  </div>
  <h2 class="font-heading text-3xl font-semibold text-ink md:text-4xl">
    {title}
  </h2>
  {lede && <p class="max-w-[58ch] text-base text-body md:text-lg">{lede}</p>}
</div>
