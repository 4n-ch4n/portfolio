---
import { getCollection } from "astro:content";
import ExperienceCard from "./experience-card.astro";
import SectionHeading from "./SectionHeading.astro";

const experiences = await getCollection("experience");
---

<section class="border-b border-rule py-16 md:py-24" id="experience">
  <div class="mx-auto max-w-5xl space-y-10 px-6 md:px-8">
    <SectionHeading label="Experience" title="What I've owned in production" />

    <div class="space-y-6">
      {
        experiences.map((exp) => (
          <div data-reveal>
            <ExperienceCard {...exp.data} />
          </div>
        ))
      }
    </div>
  </div>
</section>
