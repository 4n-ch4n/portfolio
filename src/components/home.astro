<section class="overflow-hidden border-b border-rule py-16 md:py-24" id="home">
  <div
    class="mx-auto grid max-w-5xl items-center gap-10 px-6 md:px-8 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-14"
  >
    <div class="space-y-8">
      <div class="space-y-3">
        <p class="font-mono text-sm text-muted">
          Medellín, Colombia
        </p>
        <h1 class="typewriter-name font-bold text-ink">
          <span class="sr-only">Anthony Londoño Calle</span><span
            data-typewriter
            aria-hidden="true">Anthony Londoño Calle</span
          ><span class="caret" aria-hidden="true"></span>
        </h1>
        <p class="font-heading text-xl font-medium text-accent md:text-2xl">
          Full stack developer — Node.js and clean architecture
        </p>
      </div>

      <div
        class="max-w-[58ch] space-y-4 text-base leading-relaxed text-body md:text-lg"
      >
        <p>
          I build distributed backends in production. At Iglua I maintain five
          microservices on a hybrid SQL/NoSQL stack, and I built the reporting
          engine that moved the company's core workflow off paper and into the
          product.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target={social.external ? "_blank" : undefined}
              rel={social.external ? "noopener noreferrer" : undefined}
              aria-label={social.label}
              class="inline-flex size-11 items-center justify-center rounded-md border border-rule bg-raised text-body transition-colors duration-150 hover:border-accent hover:text-accent"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
                aria-hidden="true"
              >
                <path d={social.icon} />
              </svg>
            </a>
          ))
        }
      </div>

      <p class="font-mono text-xs text-muted">
        Spanish (native) · English (B2)
      </p>
    </div>

    <div class="lg:-mr-16 lg:pt-2 xl:-mr-28">
      <HeroMesh />
    </div>
  </div>
</section>

<script>
  const target = document.querySelector<HTMLElement>("[data-typewriter]");
  const heading = target?.closest<HTMLElement>(".typewriter-name");

  if (target && heading) {
    const full = target.textContent ?? "";
    target.textContent = "";
    heading.classList.add("is-typing");

    let i = 0;
    const tick = () => {
      target.textContent = full.slice(0, ++i);
      if (i < full.length) {
        window.setTimeout(tick, 85);
      } else {
        heading.classList.remove("is-typing");
        heading.classList.add("is-done");
      }
    };
    window.setTimeout(tick, 250);
  }
</script>

<style>
  /* Width comes from the typed content, not from a ch count or a percentage —
     the two things that made the previous CSS-only versions depend on font
     metrics and container width. */
  .typewriter-name {
    display: block;
    min-height: 1.25em;
    line-height: 1.25;
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 6.2vw, 2.5rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Hidden from first paint so the full name never flashes before the script
     blanks it. Scoped to .js so a JS failure leaves the name visible. */
  :global(.js) [data-typewriter] {
    visibility: hidden;
  }

  .is-typing [data-typewriter],
  .is-done [data-typewriter] {
    visibility: visible;
  }

  .caret {
    display: none;
    width: 2px;
    height: 0.86em;
    margin-left: 0.06em;
    background: var(--color-flow-mark);
    /* Baseline-anchored so the bar spans the glyph body (baseline to just past
       cap height) instead of hanging down to the descender line. */
    vertical-align: baseline;
    position: relative;
    bottom: -0.1em;
    animation: caret-blink 1s step-end infinite;
  }

  :global(.js) .caret {
    display: inline-block;
  }

  .is-done {
    animation: name-glow 1.4s ease-out 1 forwards;
  }

  @keyframes caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes name-glow {
    0% {
      text-shadow:
        0 0 20px color-mix(in srgb, var(--color-flow-mark) 70%, transparent),
        0 0 7px color-mix(in srgb, var(--color-flow-mark) 45%, transparent);
    }
    100% {
      text-shadow: 0 0 0 transparent;
    }
  }
</style>
