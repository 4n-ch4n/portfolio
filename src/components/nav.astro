---
interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Education", href: "#education" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="sticky top-0 z-50 border-b border-rule bg-surface/95 backdrop-saturate-150"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4 md:px-8"
  >
    <a
      href="#home"
      class="shrink-0 font-mono text-sm font-semibold tracking-wide text-ink transition-colors duration-150 hover:text-accent"
    >
      AL<span class="text-accent">.</span>
    </a>

    <ul
      class="scrollbar-hidden flex min-w-0 items-center gap-1 overflow-x-auto md:gap-2"
    >
      {
        navItems.map((item) => (
          <li class="shrink-0">
            <a
              href={item.href}
              data-nav-link
              class="nav-link inline-flex min-h-11 items-center px-2.5 font-mono text-xs tracking-wide text-muted transition-colors duration-150 hover:text-ink md:px-3 md:text-sm"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const links = new Map<string, HTMLAnchorElement>(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")].map(
      (a) => [a.hash.slice(1), a],
    ),
  );

  const setActive = (id: string | null) => {
    for (const link of links.values()) {
      link.classList.remove("active");
      link.removeAttribute("aria-current");
    }
    const active = id ? links.get(id) : undefined;
    active?.classList.add("active");
    active?.setAttribute("aria-current", "true");
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.find((entry) => entry.isIntersecting);
      if (visible) setActive(visible.target.id);
    },
    { rootMargin: "-20% 0px -70% 0px" },
  );

  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>

<style>
  .nav-link.active {
    color: var(--color-ink);
  }

  .nav-link.active::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 7px;
    border-radius: 9999px;
    background: var(--color-flow-mark);
  }
</style>
