---
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="border-b border-rule py-16 md:py-24" id="projects">
  <div class="mx-auto max-w-5xl space-y-12 px-6 md:px-8">
    <SectionHeading
      label="Projects"
      title="Systems I built to understand them"
      lede="Written outside work, on my own time — not from a course scaffold."
    />

    <div class="space-y-12">
      {
        projects.map((project, i) => {
          const { title, kind, stack, body, repo, demo } = project.data;

          return (
            <article
              data-reveal
              style={`--reveal-delay:${Math.min(i, 3) * 60}ms`}
              class="relative border-l-2 border-rule pl-6 transition-colors duration-150 hover:border-accent md:pl-8"
            >
              <div class="space-y-5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-heading text-2xl font-semibold text-ink md:text-3xl">
                    {title}
                  </h3>
                  <span class="font-mono text-xs tracking-wide text-muted uppercase">
                    {kind === "personal" ? "Personal" : "Work"}
                  </span>
                </div>

                <div class="max-w-[62ch] space-y-3 text-sm leading-relaxed text-body md:text-base">
                  {body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                <div class="flex flex-wrap gap-2">
                  {stack.map((tech) => (
                    <span class="rounded-md border border-rule bg-raised px-2.5 py-1 font-mono text-xs text-body">
                      {tech}
                    </span>
                  ))}
                </div>

                <div class="flex flex-wrap gap-5 font-mono text-sm">
                  {repo && (
                    <a
                      href={repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-body underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
                    >
                      Code ↗
                    </a>
                  )}
                  {demo && (
                    <a
                      href={demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-body underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
                    >
                      Live product ↗
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
